{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elastic.co/loom/schemas/platform-audit.schema.json",
  "title": "Loom Platform Audit",
  "type": "object",
  "required": ["meta", "platform", "feature_audit", "overall_status"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["slug", "audit_date", "audit_mode"],
      "properties": {
        "slug": { "type": "string" },
        "audit_date": { "type": "string" },
        "audit_mode": { "type": "string", "enum": ["partial", "full"] },
        "discovery_version": { "type": ["string", "null"] },
        "diagnostic_version": { "type": ["string", "null"] },
        "platform_summary": { "type": "string" },
        "scope_source": {
          "type": "string",
          "enum": ["capability_map", "demo_scope_signals", "discovery"],
          "description": "capability_map = audited the frozen ideation map (required once ideation is frozen)"
        },
        "capability_map_hash": {
          "type": ["string", "null"],
          "description": "sha256 of demo/{slug}-capability-map.json at audit time — must match the frozen map for demo-path commit"
        }
      },
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "required": ["version", "deployment_type", "version_verified"],
      "properties": {
        "version": { "type": "string" },
        "license_type": { "type": "string" },
        "deployment_type": { "type": "string", "enum": ["ech", "serverless", "self_managed", "docker", "unknown"] },
        "version_verified": { "type": "boolean" },
        "license_verified": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "feature_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "planned", "status", "requirement_met", "demo_impact"],
        "properties": {
          "feature": { "type": "string" },
          "capability_id": { "type": ["string", "null"], "description": "Capability map id this row audits" },
          "origin": { "type": ["string", "null"], "enum": ["vision", "sa_added", "sa_requested", "implied", null] },
          "planned": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ready", "setup_required", "upgrade_required", "blocked", "unverified", "descoped"] },
          "remediation_owner": {
            "type": ["string", "null"],
            "enum": ["pipeline", "manual_once", "customer", null],
            "description": "Amber subtype: pipeline = Loom authors it in Build (default); manual_once = one non-automatable step surfaced on Readiness; customer = needs customer/SA evidence or action (version, license, diagnostic)"
          },
          "requirement_met": {
            "type": "object",
            "properties": {
              "version": { "type": "boolean" },
              "license": { "type": "boolean" },
              "infrastructure": { "type": "boolean" },
              "configuration": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "gap": { "type": ["string", "null"] },
          "remediation": { "type": ["string", "null"] },
          "effort": { "type": ["string", "null"] },
          "demo_impact": { "type": "string" },
          "alternative": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "overall_status": { "type": "string", "enum": ["green", "amber", "red"] },
    "blocking_count": { "type": "integer", "minimum": 0 },
    "setup_required_count": { "type": "integer", "minimum": 0 },
    "ready_count": { "type": "integer", "minimum": 0 },
    "pre_demo_tasks": { "type": "array", "items": { "type": "object" } },
    "descoped_features": { "type": "array", "items": { "type": ["object", "string"] } },
    "recommended_alternatives": { "type": "array", "items": { "type": ["object", "string"] } }
  },
  "additionalProperties": true
}
