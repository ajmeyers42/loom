{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elastic.co/loom/schemas/gap-responses.schema.json",
  "title": "Loom Gap Responses",
  "description": "opportunity/{slug}-gap-responses.json — optional Path B accelerator keyed by gap_id. Inputs edits + re-listen (Path A) remain first-class.",
  "type": "object",
  "required": ["slug", "responses"],
  "properties": {
    "slug": { "type": "string" },
    "updated_at": { "type": "string" },
    "responses": {
      "type": "object",
      "patternProperties": {
        "^g_[a-z0-9_]+$": { "$ref": "#/$defs/response" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "response": {
      "type": "object",
      "required": ["status", "responded_by", "responded_at"],
      "properties": {
        "status": { "type": "string", "enum": ["open", "answered", "accepted_risk", "deferred"] },
        "response": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"], "description": "Required when status is accepted_risk" },
        "responded_by": { "type": "string", "minLength": 1 },
        "responded_at": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
